{
  "name": "@anydocs/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:public": "node scripts/gen-public-assets.mjs public",
    "build": "next build --webpack",
    "docs:export": "node scripts/gen-public-assets.mjs export",
    "desktop:export": "node scripts/gen-public-assets.mjs desktop",
    "docs:preview": "node scripts/gen-public-assets.mjs preview",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm --filter @anydocs/editor build && playwright test",
    "test:e2e:p0": "pnpm --filter @anydocs/editor build && playwright test --grep @p0",
    "test:e2e:p1": "pnpm --filter @anydocs/editor build && playwright test --grep \"@p0|@p1\"",
    "test:api": "pnpm --filter @anydocs/editor build && playwright test tests/e2e/studio-local-api.spec.ts",
    "test": "pnpm --filter @anydocs/editor build && playwright test",
    "test:ui": "pnpm --filter @anydocs/editor build && playwright test --ui",
    "test:p0": "pnpm --filter @anydocs/editor build && playwright test --grep @p0",
    "test:unit": "pnpm --filter @anydocs/core build && pnpm --filter @anydocs/editor build && node --experimental-strip-types --test --test-concurrency=1 lib/editor-host/*.test.ts lib/runtime/*.test.ts components/studio/hosts/*.test.ts components/studio/*.test.ts"
  },
  "dependencies": {
    "@anydocs/core": "workspace:*",
    "@anydocs/editor": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.542.0",
    "mermaid": "^11.13.0",
    "minisearch": "^7.1.2",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "slate": "^0.123.0",
    "slate-dom": "^0.123.0",
    "slate-react": "^0.123.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
