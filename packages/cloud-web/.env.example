# Cloud Team Edition — cloud-web environment

# Postgres (same instance as cloud-core). See packages/cloud-core/.env.example.
DATABASE_URL=postgres://anydocs:anydocs@localhost:5432/anydocs_cloud

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Browser client base URL. Optional — defaults to the current origin (auth is mounted
# same-origin at /api/auth). Set only when the auth API lives on a different host.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# OAuth is a declared extension point (AC4): social sign-in is Better Auth configuration,
# not a code change to the sign-in flow. To enable a provider, set its secrets here and add
# the provider to getAuth()'s `socialProviders` in @anydocs/cloud-core; the sign-in page then
# calls signIn.social({ provider }). No provider secrets are wired in this edition by default.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Realtime (Hocuspocus) WebSocket endpoint (cloud-realtime service)
NEXT_PUBLIC_REALTIME_URL=ws://localhost:1234
