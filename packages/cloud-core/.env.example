# Cloud Team Edition — cloud-core environment
# Postgres connection (provider-agnostic). Examples:
#   Local Docker:  postgres://anydocs:anydocs@localhost:5432/anydocs_cloud
#   Neon:          postgres://USER:PASSWORD@ep-xxx.region.aws.neon.tech/anydocs?sslmode=require
DATABASE_URL=postgres://anydocs:anydocs@localhost:5432/anydocs_cloud

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Local Postgres via Docker (one-liner for dev):
#   docker run --name anydocs-pg -e POSTGRES_USER=anydocs -e POSTGRES_PASSWORD=anydocs \
#     -e POSTGRES_DB=anydocs_cloud -p 5432:5432 -d postgres:16
